{
    "name": "Open chrome://extensions/ on startup",
    "description": "Open chrome://extensions on start-up of Chrome / on click of button.",
    "version": "1",
    "manifest_version": 3,
    "minimum_chrome_version": "88",
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "48": "icon48.png"
    },
    "action": {
        "default_icon": "icon19.png",
        "default_title": "Open chrome://extensions/"
    },
    "permissions": ["tabs"]
}
